<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 2026-10-18：监听蓝牙耳机断开（A2DP/Headset 连接状态广播） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MusicApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.OpenShareLinkActivity"
            android:exported="true" />

        <activity android:name=".activity.MoreActivity" android:exported="false" />
        <activity android:name=".activity.SearchActivity" android:exported="false" />
        <!-- F3：本地黑名单管理页（入口在「设置 → 黑名单」） -->
        <activity android:name=".activity.HiddenTracksActivity" android:exported="false" />
        <!-- T1：本地歌曲设置页（黑名单 / 响度 / 后续扫描范围） -->
        <activity android:name=".activity.LocalMusicSettingsActivity" android:exported="false" />
        <!-- L6：自定义扫描目录管理页 -->
        <activity android:name=".activity.ScanDirsActivity" android:exported="false" />
        <activity android:name=".activity.FavoritesListActivity" android:exported="false" />
        <activity android:name=".activity.DownloadListActivity" android:exported="false" />
        <activity android:name=".activity.LocalMusicActivity" android:exported="false" />
        <activity android:name=".activity.LanTransferActivity" android:exported="false" />
        <activity android:name=".activity.LetterPickerActivity" android:exported="false" />
        <activity android:name=".activity.PlaybackStatsActivity" android:exported="false" />
        <activity android:name=".activity.SettingsActivity" android:exported="false" />
        <activity android:name=".activity.LanguageLearningActivity" android:exported="false" />
        <activity android:name=".activity.ArtistDetailActivity" android:exported="false" />
        <activity android:name=".activity.SimilarActivity" android:exported="false" />
        <activity android:name=".activity.ListeningRankActivity" android:exported="false" />
        <activity android:name=".activity.BackgroundSettingsActivity" android:exported="false" />
        <activity android:name=".activity.ToggleSettingsActivity" android:exported="false" />
        <activity android:name=".activity.LoginActivity" android:exported="false" />
        <activity android:name=".activity.PasswordLoginActivity" android:exported="false" />
        <activity android:name=".activity.CaptchaLoginActivity" android:exported="false" />
        <activity android:name=".activity.HelpActivity" android:exported="false" />
        <activity android:name=".activity.HelpDetailActivity" android:exported="false" />
        <activity android:name=".activity.AboutActivity" android:exported="false" />
        <activity android:name=".activity.OpenSourceActivity" android:exported="false" />
        <activity android:name=".activity.XtcModuleActivity" android:exported="false" />
        <activity android:name=".activity.QrLoginActivity" android:exported="false" />
        <activity android:name=".activity.SmsLoginActivity" android:exported="false" />
        <activity android:name=".activity.CookieLoginActivity" android:exported="false" />
        <activity android:name=".activity.LyricsActivity" android:exported="false" />
        <activity android:name=".activity.RingtoneListActivity" android:exported="false" />
        <activity android:name=".activity.ProfileActivity" android:exported="false" />
        <activity android:name=".activity.TopListActivity" android:exported="false" />
        <activity android:name=".activity.TopListDetailActivity" android:exported="false" />
        <activity android:name=".activity.HistoryActivity" android:exported="false" />
        <activity android:name=".activity.SongRecognitionActivity" android:exported="false" />
        <activity android:name=".activity.SongRecognitionResultActivity" android:exported="false" />
        <activity android:name=".activity.WebVerifyActivity" android:exported="false" />
        <activity android:name=".activity.SongInfoActivity" android:exported="false" />
        <activity android:name=".activity.CommentActivity" android:exported="false" />
        <activity android:name=".activity.CommentFloorActivity" android:exported="false" />
        <activity android:name=".activity.PlaylistDetailActivity" android:exported="false" />
        <activity android:name=".activity.MyPlaylistsActivity" android:exported="false" />
        <activity android:name=".activity.LocalPlaylistDetailActivity" android:exported="false" />
        <activity android:name=".activity.DailyRecommendActivity" android:exported="false" />
        <activity android:name=".activity.MusicCloudActivity" android:exported="false" />
        <activity android:name=".activity.CloudUploadProgressActivity" android:exported="false" />
        <activity android:name=".activity.EditMoreActivity" android:exported="false" />
        <activity android:name=".activity.UpdateActivity" android:exported="false" />
        <activity android:name=".activity.MvDetailActivity" android:exported="false" />
        <activity android:name=".activity.MvPlayerActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliBvidActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliLoginActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliFavoritesActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliHistoryActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliPlaylistActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliSearchActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliCloudFavoritesActivity" android:exported="false" />
        <activity android:name=".activity.BilibiliCloudFavoriteVideosActivity" android:exported="false" />
        <activity android:name=".activity.PersonalFMActivity" android:exported="false" />
        <activity android:name=".activity.AlbumDetailActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <service
            android:name=".service.MusicPlaybackService"
            android:exported="false" />

        <service
            android:name=".service.LanTransferService"
            android:exported="false" />

        <receiver
            android:name=".service.HeadsetMediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Required by 小天才 (XTC) system to enable the lock-screen music card -->
        <meta-data
            android:name="com.xtc.music.notification_version"
            android:value="1" />

    </application>
</manifest>
