<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material Design 3（需求方 2026-11-14：今后的设计尽量使用 MD3）。
      M2 的 colorPrimary/colorAccent 继续保留（旧控件还会读），同时补齐 M3 的
      角色色，保证 MaterialSwitch / MaterialButton 等 M3 组件有正确的配色与尺寸。
      大量自绘页面用的是显式颜色（@color/text_primary 等），不受主题切换影响。
    -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- M2 兼容属性（旧控件仍会读） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorError">@color/colorError</item>
        <!-- M3 角色色 -->
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/colorAccent</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- 系统 listSelector 是矩形高亮，长按圆角行时会露出直角；
             按下反馈改由各 item 自己的圆角 shape 提供。 -->
        <item name="android:listSelector">@null</item>
        <item name="android:colorControlHighlight">#33BB86FC</item>
    </style>

    <!-- MainActivity theme: disables system swipe-to-dismiss -->
    <style name="AppTheme.Main" parent="AppTheme">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!-- Filled primary button -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Text-only button -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
