<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material Design 3（需求方 2026-11-14：今后的设计尽量使用 MD3）。
      M2 的 colorPrimary/colorAccent 继续保留（旧控件还会读），同时补齐 M3 的
      角色色，保证 MaterialSwitch / MaterialButton 等 M3 组件有正确的配色与尺寸。
      大量自绘页面用的是显式颜色（@color/text_primary 等），不受主题切换影响。
    -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- M2 兼容属性（旧控件仍会读） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorError">@color/colorError</item>
        <!-- M3 角色色 -->
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/colorAccent</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- 系统 listSelector 是矩形高亮，长按圆角行时会露出直角；
             按下反馈改由各 item 自己的圆角 shape 提供。 -->
        <item name="android:listSelector">@null</item>
        <item name="android:colorControlHighlight">#33BB86FC</item>
        <!-- P1-10：半透明强调色（按下态 / 选中态底），各主题覆盖 -->
        <item name="colorAccentSoft">#33BB86FC</item>
    </style>

    <!-- MainActivity theme: disables system swipe-to-dismiss -->
    <style name="AppTheme.Main" parent="AppTheme">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!-- Filled primary button -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Text-only button -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============================================================
         P1-10：主题换肤（只换强调色，不做深浅色切换）
         AppTheme 本身是「经典紫」，下面每套只覆盖强调色相关角色。
         ============================================================ -->
    <style name="Theme.App.Green" parent="AppTheme">
        <item name="colorPrimary">#39C5BB</item>
        <item name="colorPrimaryDark">#1F6E67</item>
        <item name="colorAccent">#39C5BB</item>
        <item name="colorPrimaryContainer">#39C5BB</item>
        <item name="colorSecondary">#5FE3D8</item>
        <item name="colorSecondaryContainer">#5FE3D8</item>
        <item name="android:colorControlHighlight">#3339C5BB</item>
        <item name="colorAccentSoft">#3339C5BB</item>
    </style>

    <style name="Theme.App.Blue" parent="AppTheme">
        <item name="colorPrimary">#4A9EFF</item>
        <item name="colorPrimaryDark">#1F5FA8</item>
        <item name="colorAccent">#4A9EFF</item>
        <item name="colorPrimaryContainer">#4A9EFF</item>
        <item name="colorSecondary">#7FC0FF</item>
        <item name="colorSecondaryContainer">#7FC0FF</item>
        <item name="android:colorControlHighlight">#334A9EFF</item>
        <item name="colorAccentSoft">#334A9EFF</item>
    </style>

    <style name="Theme.App.Orange" parent="AppTheme">
        <item name="colorPrimary">#FF9F43</item>
        <item name="colorPrimaryDark">#A85F16</item>
        <item name="colorAccent">#FF9F43</item>
        <item name="colorPrimaryContainer">#FF9F43</item>
        <item name="colorSecondary">#FFC078</item>
        <item name="colorSecondaryContainer">#FFC078</item>
        <item name="android:colorControlHighlight">#33FF9F43</item>
        <item name="colorAccentSoft">#33FF9F43</item>
    </style>

    <!-- B站粉：需求方 2026-11-21 指定 #FE65A6（原樱花粉） -->
    <style name="Theme.App.Pink" parent="AppTheme">
        <item name="colorPrimary">#FE65A6</item>
        <item name="colorPrimaryDark">#A83E6B</item>
        <item name="colorAccent">#FE65A6</item>
        <item name="colorPrimaryContainer">#FE65A6</item>
        <item name="colorSecondary">#FF9CC5</item>
        <item name="colorSecondaryContainer">#FF9CC5</item>
        <item name="android:colorControlHighlight">#33FE65A6</item>
        <item name="colorAccentSoft">#33FE65A6</item>
    </style>

    <!-- 网易云红：需求方指定的 (252,61,73) = #FC3D49 -->
    <style name="Theme.App.NeteaseRed" parent="AppTheme">
        <item name="colorPrimary">#FC3D49</item>
        <item name="colorPrimaryDark">#A82830</item>
        <item name="colorAccent">#FC3D49</item>
        <item name="colorPrimaryContainer">#FC3D49</item>
        <item name="colorSecondary">#FF6E78</item>
        <item name="colorSecondaryContainer">#FF6E78</item>
        <item name="android:colorControlHighlight">#33FC3D49</item>
        <item name="colorAccentSoft">#33FC3D49</item>
    </style>

    <!-- 星蓝：需求方指定的 (86,134,254) = #5686FE -->
    <style name="Theme.App.StarBlue" parent="AppTheme">
        <item name="colorPrimary">#5686FE</item>
        <item name="colorPrimaryDark">#2E4B9E</item>
        <item name="colorAccent">#5686FE</item>
        <item name="colorPrimaryContainer">#5686FE</item>
        <item name="colorSecondary">#7FA6FF</item>
        <item name="colorSecondaryContainer">#7FA6FF</item>
        <item name="android:colorControlHighlight">#335686FE</item>
        <item name="colorAccentSoft">#335686FE</item>
    </style>

    <!-- 必刷题绿：需求方 2026-11-21 指定 RGB(147,213,10) = #93D50A -->
    <style name="Theme.App.ExamYellow" parent="AppTheme">
        <item name="colorPrimary">#93D50A</item>
        <item name="colorPrimaryDark">#5E8A06</item>
        <item name="colorAccent">#93D50A</item>
        <item name="colorPrimaryContainer">#93D50A</item>
        <item name="colorSecondary">#B4E84E</item>
        <item name="colorSecondaryContainer">#B4E84E</item>
        <item name="android:colorControlHighlight">#3393D50A</item>
        <item name="colorAccentSoft">#3393D50A</item>
    </style>
</resources>
