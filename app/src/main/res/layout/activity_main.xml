<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_player_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- M3：左上角歌单按钮已移除（能力迁到「更多功能」菜单的「播放列表」项） -->

    <!--
      M4 顶栏（2026-10-17 按需求方口径调整）：自上而下 =
        **时间（居中、小字）** → **标题行（左标题 + 右侧预制菜单区）** → **分隔线** → **作者**。

      ⚠️ 跑马灯硬约束（M4 第 3 点，改这里前务必读）：
      歌名用的是**系统 marquee**（见 `setupMarquee()`），偏移量由 TextView 内部持有，
      **一旦发生布局就会被重置回行首**。所以：
        1. 歌名宽度必须**只随屏幕/密度变化、不随文本变化** —— 这里用 0dp + weight=1
           （右侧菜单区固定 40dp ⇒ 歌名宽度恒定）；
        2. 时间必须**等宽（tnum）+ 固定字号** ⇒ 宽度不随数字变化 ⇒ 自走时不触发布局。
      这两条一旦破坏，表现就是「歌名滚一小段就跳回开头」。
    -->
    <LinearLayout
        android:id="@+id/main_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!--
          时间：**标题之上、水平居中、字号不大**（12sp = watch_text_caption）。
          match_parent + gravity=center ⇒ 居中；`tnum`（等宽数字）保证宽度不随数字变化，
          配合固定字号 ⇒ 自走时不触发布局（否则会把歌名 marquee 冲回行首，见下）。
        -->
        <TextClock
            android:id="@+id/tv_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/watch_text_caption" />

        <!-- 标题行：左标题 + 右侧预制菜单区（等高、居中） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--
              歌名：**系统 marquee**（`setupMarquee()` 里 setSelected(true) 驱动），左对齐。
              宽度用 0dp + weight=1 ⇒ 由「父宽 − 菜单按钮宽」决定，**不随文本变化**，
              这样 marquee 的偏移才不会被布局重置回行首（M4 第 3 点硬约束）。
            -->
            <TextView
                android:id="@+id/tv_song_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="start"
                android:includeFontPadding="false"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/no_song"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_text_title"
                android:textStyle="bold" />

            <!-- （时间已上提到标题之上；曲师移到分隔线之下） -->

        <!--
          右侧：预制菜单区（与标题行等高）。「数量与内容由配置决定」（M4 第 1 点）。
        -->
        <LinearLayout
            android:id="@+id/main_top_bar_menu"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/ic_more_vert"
                android:tint="?attr/colorPrimary"
                android:alpha="0.87"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        </LinearLayout>

        <!-- 分隔线（参考图：标题下方整宽一条） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:background="@color/divider" />

        <!-- 作者：小字，分隔线之下、左对齐 -->
        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_text_sub" />
    </LinearLayout>

    <!--
      底部安全区：给圆形表盘下边缘留一点余量，避免最底下一排（音量键）顶到
      物理圆角被切除。内容块会以 layout_above 停靠在它上方。
    -->
    <View
        android:id="@+id/bottom_safe_area"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true" />

    <!--
      居中内容块：不再用 layout_centerInParent（那是对父容器全边界居中，UI 放大后
      会顶到顶栏把「更多」(⋮) 按钮盖住）。改挂到**顶栏**之下、底部安全区之上，再用
      gravity="center" 在安全带内竖直居中 —— 任意缩放下都不会再和顶栏重叠。
      M4 起改挂 `@id/main_top_bar`（原先挂 `@id/btn_more`，而按钮现在在顶栏内部）。
    -->
    <LinearLayout
        android:id="@+id/main_content_block"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_top_bar"
        android:layout_above="@id/bottom_safe_area"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!--
          中间信息区（歌名 / 曲师 / 进度 / 时间）：唯一「可以伸缩」的一段，weight=1。

          为什么必须这样做：本页从头到尾都是按 dp 写死高度的，而手表分辨率不变、**密度会变**
          （本机从 270 提到 320，同样 44dp 的按钮就长了 18%）。原来整块是 wrap_content
          再居中，内容总高一旦超过「顶栏按钮 ↔ 底部安全区」这条安全带，底部两行操作按钮
          就会被顶到带外——表现就是「下三个按钮被挤出去」，密度越高越明显。
          改成「信息区吸收全部伸缩、两行按钮固定在底部」后，无论密度怎么变，
          播放控制与音量/功能按钮永远贴在安全区之上。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

        <!--
          M4：歌名（`tv_song_name`）与曲师（`tv_artist`）已**搬到顶栏**
          `@id/main_top_bar` 的左栏，不再属于中部信息区。
          中部信息区现在只放「进度条 + 时间」——它依旧是那唯一可伸缩的一段（weight=1）。
        -->

        <!--
          进度区重排（避免"歌名滚动稳定性 vs 进度条宽度"二选一）：
            第 1 行 = SeekBar 独占整行 → 进度条拿到全部可用宽度，不再被时间标签挤压；
            第 2 行 = 当前时间（左） / 总时长（右）。
          时间标签仍保持"固定宽度"：宽度不变时 setText 只重绘、不触发布局，
          这样主页歌名的 marquee 才不会因播放中的每秒刷新被重置回行首。
        -->
        <!--
          进度条高度必须「收口」：SeekBar 是 wrap_content 时，其可绘制(thumb+track)自带的
          上下留白会把剩余空间全部吃掉 —— 实测它独占 36px 后，紧挨着的时间行被压成 0px。
          这里显式限定高度，让进度条只拿它该拿的那一份，剩余空间留给时间标签。
        -->
        <!--
          M4b（需求方 2026-10-17）：「进度条改进：将时间标签放在进度条的左右两侧」。
          一行 = [当前时间] [进度条 weight=1] [总时长]；整行仍由外层「信息区 weight=1 + gravity=center」
          在其可用高度里竖直居中 —— 原先时间行在进度条下方，视觉上进度条偏上。
          时间标签保持**固定宽度 44dp + tnum**（否则播放中每秒 setText 会 requestLayout，
          把主页歌名的 marquee 冲回行首）。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              M4c（需求方 2026-10-17）：进度条曾被时间标签挤到约 80px → 标签收窄到 32dp/10sp 加宽了进度条；
              M4d（需求方 2026-10-17 晚）：「固定宽度遇到长时长会被挤成竖行」→ 改成**按曲目可变宽度**：
                - XML 里先 wrap_content（首帧由运行时按最长格式写死具体 px）；
                - 运行时 `syncTimeLabelWidth(duration)` 用 Paint 量出「最长格式」宽度（如 1:02:03），
                  把两个标签的 LayoutParams.width 固定成该值；
                - 同一首歌播放期间宽度不变（固定宽 + 固定高 ⇒ setText 不 requestLayout），
                  所以每秒刷新时间**不会**把主页歌名跑马灯冲回行首。
            -->
            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="1"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:maxHeight="20dp"
                android:minHeight="20dp"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="1"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

        </LinearLayout>

        <!-- Playback controls row -->
        <!-- 高度 44->40dp、上间距 3->2dp：给上方信息区让出空间（高密度下时间标签行曾被压成 0px） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_previous"
                android:alpha="0.87"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:src="@drawable/ic_play_arrow"
                android:alpha="1.0"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                android:alpha="0.87"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Volume / function controls row -->
        <!-- 高度 38->34dp、上下间距收紧：同样是为信息区让位，同时仍保证 >=34dp 的可点区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              M1：原来左右两个音量键（btn_vol_down / btn_vol_up）**合并为这一个入口**，
              点击弹出**可拖拽/可点击**的音量条（MainActivity#showVolumeIndicator）。
            -->
            <ImageView
                android:id="@+id/btn_volume"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:src="@drawable/ic_volume_up"
                android:alpha="0.6"
                android:clickable="true"
                android:focusable="true" />

            <!-- 弹性留白：三个入口均匀分布 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--
              需求方 2026-10-17：**播放选项（⋯）与播放模式的位置互换** ——
              现在中间是 ⋯（播放选项），右侧是播放模式。
            -->
            <!--
              菜单（⋯）：保留原 id `btn_favorite`，避免牵连其它引用
            -->
            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_horiz"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--
              播放模式切换：单曲循环 / 列表循环 / 随机播放。
              图标随当前模式变化（见 MainActivity#updatePlayModeIcon），点击循环切换。
              —— 对应参考图底部中间那个箭头图标（**不是分享**）。
            -->
            <ImageView
                android:id="@+id/btn_play_mode"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:src="@drawable/ic_repeat"
                android:alpha="0.85"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
