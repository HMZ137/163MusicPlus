<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_player_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Top left playlist indicator (hidden by default) -->
    <ImageView
        android:id="@+id/btn_playlist_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:padding="6dp"
        android:src="@drawable/ic_queue_music"
        android:alpha="0.87"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Top right more button -->
    <ImageView
        android:id="@+id/btn_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        android:alpha="0.87"
        android:clickable="true"
        android:focusable="true" />

    <!--
      底部安全区：给圆形表盘下边缘留一点余量，避免最底下一排（音量键）顶到
      物理圆角被切除。内容块会以 layout_above 停靠在它上方。
    -->
    <View
        android:id="@+id/bottom_safe_area"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true" />

    <!--
      居中内容块：不再用 layout_centerInParent（那是对父容器全边界居中，UI 放大后
      会顶到顶栏把「更多」(⋮) 按钮盖住）。改挂到顶栏按钮之下、底部安全区之上，再用
      gravity="center" 在安全带内竖直居中 —— 任意缩放下都不会再和 ⋮ 重叠。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_more"
        android:layout_above="@id/bottom_safe_area"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Song name with marquee -->
        <TextView
            android:id="@+id/tv_song_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/no_song"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Artist name -->
        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- SeekBar with time labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/colorPrimary"
                android:thumbTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Playback controls row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_skip_previous"
                android:alpha="0.87"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:padding="9dp"
                android:src="@drawable/ic_play_arrow"
                android:alpha="1.0"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_skip_next"
                android:alpha="0.87"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Volume / function controls row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_vol_down"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_volume_down"
                android:alpha="0.6"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_more_horiz"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_vol_up"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_volume_up"
                android:alpha="0.6"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
