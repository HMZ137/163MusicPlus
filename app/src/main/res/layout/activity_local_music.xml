<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!--
      标题栏两行：
        第 1 行 = 右侧动作按钮（A-Z / 排序 / 随机）；
        第 2 行 = 标题「本地音乐」。
      两行一起被 WatchBackButton.applyTitleBarInset() 撑到「返回按钮占地」的高度（本机约 101px），
      所以头部总高≈一个返回按钮 —— 不再额外吃掉列表空间（这是上一版踩的坑：把占位加到第 1 行上，
      那一行被强行撑到 101px，再叠一行标题，头部近 150px，列表只剩两行半）。
      标题要放长文本（如扫描进度）放不下，所以进度改到下面的状态行去显示。
    -->
    <LinearLayout
        android:id="@+id/layout_local_music_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/layout_local_music_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--
              本页一共有 5 个操作（搜索 / 排序 / A-Z 字母索引 / 随机播放 / 局域网传歌），
              标题栏扣掉返回按钮占位后只有约 220px，一行放不下 5 个文字按钮。
              所以：最常用的两个留在外面，其余（含全部 5 个的完整入口）收进「更多」二级菜单。
            -->
            <TextView
                android:id="@+id/btn_local_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btn_local_sort"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/search"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />

            <!-- 排序方式：曲名 / 曲师 / 专辑（选择会记住） -->
            <TextView
                android:id="@+id/btn_local_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btn_local_more"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/local_music_sort"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />

            <!-- 更多：五个操作都在这里（A-Z 字母索引 / 随机播放 / 局域网传歌 等） -->
            <TextView
                android:id="@+id/btn_local_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/local_music_more"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_local_music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/local_music"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold" />

        <!--
          页内二级标签：下载 / 本地。样式与「收藏」页一致（纯文字、无底衬、等宽、仅颜色区分选中）。
          必须放在**标题栏里面**：标题栏高度被 applyTitleBarInset() 钉成「返回按钮占地」，
          只够「动作行 + 标题」两行；把标签放在外面时标题会被挤掉下半截（实机确认）。
          放进来的代价由 WatchBackButton.addTitleBarExtraHeight() 补足高度，头部总高不变。
        -->
        <LinearLayout
            android:id="@+id/ll_local_music_tabs"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_downloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="下载"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_local_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/local_music_entry"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      状态 / 筛选行：只在需要时出现 —— 扫描进度 / 搜索命中 / 已移出若干首。
      点按行为：搜索中 → 清除搜索；否则 → 打开「已移出」恢复界面。
    -->
    <TextView
        android:id="@+id/tv_status_row"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_local_music"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="0.5dp" />

    <TextView
        android:id="@+id/tv_local_music_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="未找到本地音乐"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
