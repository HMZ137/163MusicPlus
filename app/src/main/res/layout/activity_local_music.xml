<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!--
      标题栏：右侧放「A-Z」和「随机」两个动作。
      改成 RelativeLayout + layout_toStartOf 链式避让是必须的 —— 之前用的是
      LinearLayout（标题 weight=1），再加一个按钮会让标题被挤到左半边、看着像没居中。
      下载列表页早就踩过这个坑，这里直接对齐它的做法。
    -->
    <RelativeLayout
        android:id="@+id/layout_local_music_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp">

        <!-- 标题止于「A-Z」按钮之前，否则居中后会伸到按钮底下 -->
        <TextView
            android:id="@+id/tv_local_music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_local_letters"
            android:layout_centerVertical="true"
            android:text="@string/local_music"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <!-- 打开独立的字母选择页。原来那条贴边的窄索引条已经去掉，列表因此拿回全宽 -->
        <TextView
            android:id="@+id/btn_local_letters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btn_local_shuffle"
            android:layout_centerVertical="true"
            android:text="@string/local_music_letters"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_local_shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/local_music_shuffle"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!--
      局域网传歌入口。放在这里而不是「更多」菜单：MoreActivity.applyMenuOrder() 会
      removeAllViews() 后只按 key 重新加回，没在 viewByKey 里注册的磁贴会整块消失。
      而「把歌传进来」本来就是本机音乐该有的入口。
    -->
    <TextView
        android:id="@+id/btn_local_lan_transfer"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="局域网传歌"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <ListView
        android:id="@+id/lv_local_music"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="0.5dp" />

    <TextView
        android:id="@+id/tv_local_music_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="未找到本地音乐"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
