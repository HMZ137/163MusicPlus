<?xml version="1.0" encoding="utf-8"?>
<!--
  4-3 步骤③-2：完整页 LocalMusicActivity 是「薄宿主」；本布局只剩两块：
    1) 单行标题栏（左标题「本地音乐」+ 右 ☰ 菜单）+ 页内标签行（下载 / 本地）；
    2) 内容区 FrameLayout —— 由 advanced=true 的 LocalMusicFragment 填充
       （列表 / 状态行 / 空态；搜索、排序、A-Z、多选、局域网传歌的逻辑也都在这 Fragment 里）。
  需求方 2026-10-17 口径：标题与动作在**同一行**、不要错开，「更多」用矢量图标；
  搜索 / 排序 / A-Z / 随机 / 局域网传歌 / 刷新缓存全部收进 ☰ 菜单（LocalMusicFragment.showMoreDialog）。
  标题栏的竖直占位由 WatchBackButton.applySingleRowTitleBarInset() 统一处理，标签行高度另行补足。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/layout_local_music_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 单行：左标题 + 右 ☰ -->
        <RelativeLayout
            android:id="@+id/layout_local_music_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/btn_local_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_selectable_rounded"
                android:clickable="true"
                android:contentDescription="更多"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                android:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_local_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="44dp"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/local_music"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_title_text_size"
                android:textStyle="bold" />
        </RelativeLayout>

        <!--
          页内二级标签：下载 / 本地。样式与「收藏」页一致（纯文字、无底衬、等宽、仅颜色区分选中）。
          注意：本行高度由 Activity 调 WatchBackButton.addTitleBarExtraHeight() 补进标题栏占位，
          否则单行标题栏只按「返回按钮底边」算高度，标签行会把标题挤掉下半截。
        -->
        <LinearLayout
            android:id="@+id/ll_local_music_tabs"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_downloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selectable_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="下载"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_local_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selectable_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/local_music_entry"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内容区：advanced=true 的 LocalMusicFragment 挂在这里 -->
    <FrameLayout
        android:id="@+id/local_music_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
