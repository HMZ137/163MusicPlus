<?xml version="1.0" encoding="utf-8"?>
<!--
  字母选择页：独立一屏的大号字母网格。

  为什么不沿用列表右侧那条窄索引条：320px 宽的表盘上，那条竖排最窄只能塞进
  9sp 的字，一列字母挤在屏幕边缘，手指根本点不准（点偏就滚到别的位置）。
  拆成独立一屏后每格约 58×48px，是原来那个字号的 5 倍以上触控面积。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <!--
      标题不需要避让左边的浮动返回按钮：它是居中的，而返回按钮贴在最左侧，
      两者在 320px 上不会重叠（下载列表、本地音乐页也是同一套做法）。
    -->
    <TextView
        android:id="@+id/tv_letter_picker_title"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="6dp"
        android:text="@string/letter_picker_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/watch_title_text_size"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!--
      网格从左侧开始铺，会被浮动返回按钮压住第一格，所以整体下移一段。
      paddingTop 在代码里按 WatchBackButton 的实际占位算 —— 返回按钮尺寸随屏宽
      缩放（且不小于 40dp），写死数值在小屏上就会漏出来。
    -->
    <GridView
        android:id="@+id/gv_letter_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="26dp"
        android:layout_weight="1"
        android:numColumns="5"
        android:stretchMode="columnWidth"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tv_letter_picker_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/letter_picker_empty"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
