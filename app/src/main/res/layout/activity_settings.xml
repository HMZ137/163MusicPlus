<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- G3：标题栏固定在此，不随下方列表滚动（可上滑收起 / 下滑展开） -->
    <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_text_title"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

    <ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/bg_dark"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="48dp">
        <!-- 底部留白：界面缩放 115% 下本页实测「最后一行被窗口下沿裁掉约 62px」
             （滚到底也露不全，导出行/统计行会被切一半）。48dp≈93px 足以把最后一项
             顶进可视区。见 verify/F6 证据。 -->

            <LinearLayout
                android:id="@+id/btn_settings_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_tune"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="开关选项"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_advanced_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_translate"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="高级歌词翻译"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- T1：「本地歌曲设置」入口 —— 只影响本地文件的设置（黑名单/响度/扫描范围…）集中在那里 -->
            <LinearLayout
                android:id="@+id/btn_settings_local_music_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_music_note"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_local_music"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_local_music_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_edit_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_dashboard"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="编辑更多页面"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="检测更新"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chat_bubble"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="帮助"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="关于"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_open_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_code"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="开源信息"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_xtc_module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_get_app"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="小天才模块"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_image"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="自定义背景"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_delete"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="缓存管理"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_settings_cache_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/watch_text_caption"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_leaderboard"
                    android:alpha="0.7" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/playback_stats"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_text_body"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_get_app"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_music"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_settings_export_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/watch_text_caption"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
