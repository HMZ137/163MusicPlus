<?xml version="1.0" encoding="utf-8"?>
<!--
  T1：「本地歌曲设置」页。
  按文档 T1 的归类原则（「用户会去哪里找这个设置」），把**只影响本地文件**的设置集中到这里：
  黑名单（F3）、响度分析/响度平衡（F5）。后续 L6 的扫描范围、F4 的内嵌、F6 的导出目标也应落到本页。

  结构沿用项目其它设置页：标题栏（走 applyTitleBarInset 占位 + G5 统一居左）+ 可滚动行列表。
  行样式与 activity_settings.xml 完全一致，行 id **保持不变**（黑名单/Loudness 那几项），
  这样从 SettingsActivity 迁过来的接线代码可以原样复用。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/layout_local_music_settings_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_local_music_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/settings_local_music"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">
            <!-- 底部留白（D15）：界面缩放 115% 下本页滚到底也露不全最后一行（「黑名单」被切掉一半），
                 48dp≈93px 足以把最后一项顶进可视区。-->

            <!-- F5：响度平衡总开关（默认关；关闭时播放路径完全不变） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_tile">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_loudness_balance"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:tag="collapsible_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_loudness_balance_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_loudness_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" 
                    android:textOn=""
                    android:textOff=""
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    />
            </LinearLayout>

            <!-- L6：自定义扫描目录管理（文档 L6 改动要点 3：入口就在本页之下） -->
            <LinearLayout
                android:id="@+id/btn_local_settings_scan_dirs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_dirs_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:tag="collapsible_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_dirs_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- F5：响度分析（限音器）入口 —— 手动触发一次；后台、可中断、有进度 -->
            <LinearLayout
                android:id="@+id/btn_settings_loudness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_loudness"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:tag="collapsible_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_loudness_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_settings_loudness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_text_caption"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- F4：内嵌封面/歌词（把同目录的 cover.jpg / lyrics.lrc 写进音频文件标签） -->
            <LinearLayout
                android:id="@+id/btn_settings_embed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bookmark"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="内嵌封面歌词"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_settings_embed_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="写入歌曲标签"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2026-10-17：本地歌曲去重（相同内容副本移到回收站；内容不同的 A(1)(2)(3) 不动） -->
            <LinearLayout
                android:id="@+id/btn_settings_dedupe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_delete"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本地歌曲去重"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_settings_dedupe_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="相同内容的副本移入回收站"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <!-- F3：本地黑名单入口（行样式与上面各行一致；两行文案按 1-7/1-8 规则截断） -->
            <LinearLayout
                android:id="@+id/btn_settings_hidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/watch_row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_tile">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_delete"
                    android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_hidden_tracks"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_text_body"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:tag="collapsible_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_hidden_tracks_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
