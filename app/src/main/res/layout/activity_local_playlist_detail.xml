<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 标题栏：留出左上角浮动返回按钮（X）的占位高度，否则会压住第一行 -->
    <RelativeLayout
        android:id="@+id/layout_local_playlist_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_local_playlist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_local_playlist_more"
            android:layout_centerVertical="true"
            android:text="本地歌单"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="start" />

        <!-- 更多：☰ 矢量图标（需求方 2026-10-17：标题与动作同一行、更多用图标不用文字）；搜索 / 排序收进二级菜单 -->
        <ImageView
            android:id="@+id/btn_local_playlist_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_selectable_rounded"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:tint="?attr/colorPrimary" />
    </RelativeLayout>

    <!-- P3：独立信息行「N 首」（与下载页 / 收藏页同一口径） -->
    <TextView
        android:id="@+id/tv_local_playlist_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 状态行：搜索时显示命中数（点按清除搜索），平时不占高度 -->
    <TextView
        android:id="@+id/tv_status_row"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_selectable_rounded"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_local_playlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0.5dp" />

    <TextView
        android:id="@+id/tv_local_playlist_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="歌单为空"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
