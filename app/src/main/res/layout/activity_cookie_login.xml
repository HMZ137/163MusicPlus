<?xml version="1.0" encoding="utf-8"?>
<!--
  1016 合并：Cookie 登录页（上游新增页，按我方口径适配）。
  需求方 2026-10-17 补充：登录主页只留一个**只读** Cookie 展示框，所有 Cookie 相关操作
  （粘贴登录 / 保存 / 导出备份 / 读取备份）都收拢到本页。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <TextView
            android:id="@+id/tv_cookie_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cookie_login"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingBottom="8dp" />

    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/bg_dark"
    android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="粘贴完整Cookie（需含MUSIC_U）→ 登录（验证通过才保存）；也可只点「保存」"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/et_cookie_input"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@color/surface_elevated"
                android:gravity="top|start"
                android:hint="@string/cookie_hint"
                android:inputType="textMultiLine"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cookie_login"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:text="@string/login"
                android:textSize="13sp"
                android:textAllCaps="false"
                style="@style/Widget.App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_cookie"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:text="@string/save_cookie"
                android:textSize="13sp"
                android:textAllCaps="false"
                style="@style/Widget.App.Button.Outlined" />

            <!-- Cookie 备份：导出 / 读取（两个按钮并排省高度） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_cookie"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/cookie_export"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_cookie"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="@string/cookie_import"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cookie_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- 备份位置 + 最近一次导出时间，运行时填 -->
            <TextView
                android:id="@+id/tv_cookie_backup_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
