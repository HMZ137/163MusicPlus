<?xml version="1.0" encoding="utf-8"?>
<!--
  我的歌单（4-16）：ViewPager2 + Fragment 迁移后的宿主布局。
  需求方口径（2026-10-17）：
    · 迁到 ViewPager2 + Fragment 的页面不再保留多 Tab 按钮（参考 去除指示_1.png）；
    · 标题与右侧动作在**同一行**、不要错开，「更多」用**矢量图标**（☰）；
    · 「其他需要展示的内容」放到标题栏外的独立行（多Tab实例_1.bmp）。
  两页（在线歌单 / 本地歌单）由 ViewPager2 承载，左右滑切换；纯本地 / 纯在线模式下只挂一页。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <RelativeLayout
        android:id="@+id/layout_my_playlists_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/btn_my_playlists_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_my_playlists_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="44dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="我的歌单"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 「其他需要展示的内容」独立行：当前页 · 歌单数量 -->
    <TextView
        android:id="@+id/tv_my_playlists_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption" />

    <!-- 4-16：在线歌单 / 本地歌单 两页（纯本地/纯在线模式下只挂一页） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_my_playlists_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
