<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏列表（4-12~4-15）：ViewPager2 + Fragment 迁移后的布局。
  需求方口径（2026-10-17）：
    · 迁到 ViewPager2 + Fragment 的页面不再保留多 Tab 按钮（参考图 去除指示_1.png 圈掉的那行）；
    · 标题与右侧动作在**同一行**、不要错开，「更多」用**矢量图标**（☰）而不是文字；
    · 「其他需要展示的内容」放到标题栏外的独立行（参考图 多Tab实例_1.bmp）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!--
      单行标题栏：左 = 标题，右 = ☰ 菜单按钮。
      竖直占位与「标题避开浮动返回按钮」由 WatchBackButton.applySingleRowTitleBarInset() 统一处理：
      它把本行撑到返回按钮底边高度，并给左侧留出返回按钮占位（标题由 G5 机制再自动补齐）。
    -->
    <RelativeLayout
        android:id="@+id/layout_fav_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/btn_fav_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_selectable_rounded"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_favorites_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="44dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/favorites"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_text_title"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 「其他需要展示的内容」独立行：当前页 · 数量（滑动切页时跟随，由 Activity 回写） -->
    <TextView
        android:id="@+id/tv_fav_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption" />

    <!-- 4-12：三页容器（单曲 / 歌单 / 专辑），左右滑切页；标签行已按「迁移后去 Tab」口径删除 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_favorites_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
