<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- G3：标题栏固定在此，不随下方列表滚动（可上滑收起 / 下滑展开） -->
    <TextView
            android:id="@+id/tv_captcha_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="验证码登录"
            android:textColor="@color/white"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

    <ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/bg_dark"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

            <!-- Phone number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingBottom="2dp" />

            <EditText
                android:id="@+id/et_captcha_phone"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_search_box"
                android:hint="@string/phone_hint"
                android:inputType="phone"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="13sp" />

            <!-- Send captcha -->
            <TextView
                android:id="@+id/btn_send_captcha"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_outline"
                android:gravity="center"
                android:text="发送验证码"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Captcha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="短信验证码"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <EditText
                android:id="@+id/et_captcha_code"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_search_box"
                android:hint="请输入验证码"
                android:inputType="number"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="13sp" />

            <!-- Login button -->
            <TextView
                android:id="@+id/btn_captcha_login"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:text="@string/login"
                android:textColor="#1D1D1D"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Status text -->
            <TextView
                android:id="@+id/tv_captcha_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
