<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!--
      标题栏改成两行：
        第 1 行 = 右侧动作按钮（「整理」）。这一行由 WatchBackButton.applyTitleBarInset()
                  撑到返回按钮的占位高度、并留出左侧内边距，所以浮动返回按钮（X）不会压到按钮。
        第 2 行 = 标题，占满整行宽度。
      为什么必须拆行：原先标题与按钮挤在同一行，扣除返回按钮占位（本机约 100px）与按钮宽度之后，
      留给标题的宽度只剩约 50px —— 六个字「本地音乐管理」在 16sp 下需要约 220px，于是被折成竖排。
      拆行后标题能拿到整行宽度，单行完整显示。

      「本地」原先是这里的第三个按钮，现已上提为标题下方的页内标签（与「收藏」页同款样式），
      所以动作行只剩「整理」。
    -->
    <LinearLayout
        android:id="@+id/layout_downloads_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:id="@+id/layout_downloads_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btn_tidy_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/download_tidy"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/watch_text_caption" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_downloads_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/downloads"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_text_title"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- L2：「其他需要展示的内容」独立行（多Tab实例_1.bmp）：下载页显示已下载首数，本地页隐藏 -->
    <TextView
        android:id="@+id/tv_downloads_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption" />

    <!--
      4-1：内容区改为 ViewPager2 容器，承载「下载 / 本地」两页。
      「下载」页的 ListView 与空态视图已迁入 res/layout/fragment_download_tab.xml（4-2）；
      「本地」页目前是桥接占位，真实内容由 4-3 迁入。
    -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_download_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
