<?xml version="1.0" encoding="utf-8"?>
<!--
  下载管理页（4-1/4-2 起是 ViewPager2 容器；L2 去多 Tab；L7 菜单能力回归）。

  需求方口径（2026-10-17 晚）：
    · 标题与右侧动作在**同一行**、不要错开，「更多」用**矢量图标**（☰）而不是文字；
    · 「其他需要展示的内容」放标题栏外的独立行（这里显示已下载首数）。

  标题栏占位（撑到返回按钮底边 + 横向避开按钮与圆角）由
  WatchBackButton.applySingleRowTitleBarInset() 统一处理。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <RelativeLayout
        android:id="@+id/layout_downloads_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp">

        <!-- L7：☰ 菜单（内容按当前页分发：下载页 = 排序 + 整理文件名；本地页 = 本地音乐完整菜单） -->
        <ImageView
            android:id="@+id/btn_tidy_downloads"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_selectable_rounded"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_downloads_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="44dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/downloads"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_text_title"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- L2：「其他需要展示的内容」独立行（多Tab实例_1.bmp）：下载页显示已下载首数，本地页隐藏 -->
    <TextView
        android:id="@+id/tv_downloads_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption" />

    <!-- 4-1：内容区 ViewPager2（第 0 页下载 / 第 1 页本地，没有 Tab 按钮、左右滑切换） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_download_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
