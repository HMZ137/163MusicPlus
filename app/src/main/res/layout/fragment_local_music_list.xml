<?xml version="1.0" encoding="utf-8"?>
<!--
  4-3 步骤②：本地音乐 Fragment 的视图层（用于下载页「本地」标签）。
  刻意只放「列表 + 状态行 + 空态」：搜索 / A-Z 索引条 / 多选 / 局域网传歌仍留在完整页
  LocalMusicActivity 里（标签页是轻量浏览入口，完整页是全能管理入口 —— 见文档 4-3 的取舍说明）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/tv_local_music_tab_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="扫描中…"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption" />

    <ListView
        android:id="@+id/lv_local_music_tab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="0.5dp" />

    <TextView
        android:id="@+id/tv_local_music_tab_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/local_music_empty"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_sub"
        android:visibility="gone" />
</LinearLayout>
