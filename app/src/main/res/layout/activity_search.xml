<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Search bar -->
    <!--
      paddingStart 给左上角浮动返回按钮让位。这里保留 40dp 只作兜底，
      实际值由 SearchActivity 在运行时按 WatchBackButton 的真实占位覆盖 ——
      返回按钮的占位随屏宽缩放，而且从 36px 放大到 48px 之后已经超过 40dp，
      写死在这里就不够用了。
    -->
    <LinearLayout
        android:id="@+id/layout_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="40dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="@dimen/watch_text_sub" />

        <!--
          高度 30dp 与左侧输入框一致；MaterialButton 自带上下 6dp inset（XML 的
          app:insetTop 本工程 Material 版本不认），由 SearchActivity 代码里
          setInsetTop/Bottom(0) 归零，保证底衬铺满 30dp、与输入框完全等高。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            android:layout_width="52dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            android:text="@string/search"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minHeight="30dp"
            style="@style/Widget.App.Button" />
    </LinearLayout>

    <!--
      S1 收尾（需求方口径「其他 ViewPager2 + Fragment 的页面同」）：
      原「单曲 / 歌单 / MV」标签行已删除（参考 去除指示_1.png / 多Tab实例_1.bmp），
      结果页靠左右滑切换；当前页与已加载条数由下面的独立信息行显示。
    -->
    <TextView
        android:id="@+id/tv_search_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_text_caption"
        android:visibility="gone" />

    <!-- S1：三个结果标签的容器（每页一个 SearchListFragment 子类） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_search_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Search history list -->
    <ListView
        android:id="@+id/lv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:divider="@null"
        android:dividerHeight="0.5dp" />
</LinearLayout>
