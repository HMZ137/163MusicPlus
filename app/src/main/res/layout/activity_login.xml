<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="登录"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cookie"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/et_cookie"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/surface_elevated"
            android:gravity="top|start"
            android:hint="@string/cookie_hint"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_cookie"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="@string/save_cookie"
            android:textSize="13sp"
            android:textAllCaps="false"
            style="@style/Widget.App.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_login"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:text="@string/qr_login"
            android:textSize="13sp"
            android:textAllCaps="false"
            style="@style/Widget.App.Button.Outlined" />

        <!--
          Cookie 备份：导出到公共外部存储（/sdcard/163Music/cookie.txt），卸载不会被清，
          重装后点「读取 Cookie」即可恢复登录。
          两个按钮并排而不是各占一行 —— 320px 表盘竖向空间很紧，并排能省下 42px。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_cookie"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/cookie_export"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.App.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_cookie"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/cookie_import"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.App.Button.Outlined" />
        </LinearLayout>

        <!-- 备份位置 + 最近一次导出时间，运行时填 -->
        <TextView
            android:id="@+id/tv_cookie_backup_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
