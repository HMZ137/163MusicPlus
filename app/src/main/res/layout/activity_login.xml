<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- G3：标题栏固定在此，不随下方列表滚动（可上滑收起 / 下滑展开） -->
    <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="登录"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingBottom="8dp" />

    <ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/bg_dark"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

            <!-- ============ 已登录状态（1016：账号信息 / 复制 Cookie / 退出登录） ============ -->
            <LinearLayout
                android:id="@+id/ll_logged_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/account_logged_in"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_id_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tv_user_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_box"
                    android:padding="6dp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="-1"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/nickname_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_box"
                    android:padding="6dp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="-1"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_cookie"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:text="@string/copy_cookie"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        style="@style/Widget.App.Button.Outlined" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_logout"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:text="@string/logout"
                        android:textColor="@color/colorError"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        style="@style/Widget.App.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Cookie 输入 / 保存（保留原样式） ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cookie"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/et_cookie"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_search_box"
                android:gravity="top|start"
                android:hint="@string/cookie_hint"
                android:inputType="textMultiLine"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_cookie"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:text="@string/save_cookie"
                android:textSize="13sp"
                android:textAllCaps="false"
                style="@style/Widget.App.Button" />

            <!-- ============ 登录入口（需求方 2026-10-17 晚：登录方式全部收进「更多登录选项」弹窗） ============ -->
            <LinearLayout
                android:id="@+id/ll_not_logged_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/not_logged_in"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <!-- 点它弹「登录方式」浮窗：扫码登录 / 密码登录 / 验证码登录（选中后跳对应页面） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_more_login_options"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="@string/more_login_options"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />

                <!-- 1016：Cookie 登录（粘贴完整 Cookie 并验证后保存） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cookie_login_entry"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/cookie_login"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />
            </LinearLayout>            <!-- ============ Cookie 备份：导出 / 读取（保持在最下面） ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_cookie"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/cookie_export"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_cookie"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="@string/cookie_import"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    style="@style/Widget.App.Button.Outlined" />
            </LinearLayout>

            <!-- 备份位置 + 最近一次导出时间，运行时填 -->
            <TextView
                android:id="@+id/tv_cookie_backup_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
